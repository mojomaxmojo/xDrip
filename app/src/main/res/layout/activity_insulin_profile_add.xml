<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/insulin_profile_add_header"
            android:textSize="18sp"
            android:paddingBottom="8dp" />

        <TextView
            style="@style/InsulinFormLabel"
            android:text="@string/insulin_profile_name" />
        <EditText
            android:id="@+id/insulinNameField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="@string/insulin_profile_name_hint" />

        <TextView
            style="@style/InsulinFormLabel"
            android:text="@string/insulin_profile_display_name" />
        <EditText
            android:id="@+id/insulinDisplayNameField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="@string/insulin_profile_display_name_hint" />

        <TextView
            style="@style/InsulinFormLabel"
            android:text="@string/insulin_profile_concentration" />
        <EditText
            android:id="@+id/insulinConcentrationField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="U100" />

        <TextView
            style="@style/InsulinFormLabel"
            android:text="@string/insulin_profile_ppn" />
        <EditText
            android:id="@+id/insulinPpnField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="@string/insulin_profile_ppn_hint" />

        <TextView
            style="@style/InsulinFormLabel"
            android:text="@string/insulin_profile_onset" />
        <EditText
            android:id="@+id/insulinOnsetField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="15" />

        <TextView
            style="@style/InsulinFormLabel"
            android:text="@string/insulin_profile_peak" />
        <EditText
            android:id="@+id/insulinPeakField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="60-180" />

        <TextView
            style="@style/InsulinFormLabel"
            android:text="@string/insulin_profile_duration" />
        <EditText
            android:id="@+id/insulinDurationField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="300" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:gravity="center">

            <Button
                android:id="@+id/insulinAddCancelBtn"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="cancelButtonClick"
                android:text="@string/cancel" />

            <Button
                android:id="@+id/insulinAddSaveBtn"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="saveButtonClick"
                android:text="@string/save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
